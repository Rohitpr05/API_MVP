# RapidAPI Marketplace - JSON Extraction API
# Environment Variables Configuration

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_API_BASE_URL=https://your-render-app.onrender.com

# Application Metadata
APP_NAME=JSON Extraction API
APP_VERSION=1.0.0

# RapidAPI Marketplace Authentication
# Get this from your RapidAPI dashboard
RAPIDAPI_PROXY_SECRET=your-rapidapi-proxy-secret-here

# OpenRouter API (LLM Provider)
# Get free API key from https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=10000

# Extraction Pipeline Tuning (Optional)
CHROMIUM_PATH=
BROWSER_LAUNCH_TIMEOUT=10000
PAGE_GOTO_TIMEOUT=10000
EXTRACTION_TIMEOUT=45000
EXTRACTION_MAX_CONTENT=12000
EXTRACTION_MODEL=deepseek/deepseek-chat

